# =============================================================================
# DashNode backend - environment template
#
# Copy to `.env` (never commit `.env`) or generate it with random secrets:
#     python scripts/generate_env.py
# Values like CHANGE_ME_* are placeholders and must not be used as real secrets.
# =============================================================================

# --- Runtime profile: development | testing | production --------------------
APP_ENV=development

# --- PostgreSQL (local container defined in docker-compose.yml) -------------
# Used by docker compose to create the database and by the API container.
POSTGRES_USER=dashnode_app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=dashnode
# Host port published by the db container (5432 is often taken by a local server).
POSTGRES_HOST_PORT=5434

# Connection string used when the API runs on the host (outside Docker).
# 127.0.0.1 instead of `localhost` avoids slow IPv6 fallbacks on Docker Desktop (Windows).
# Inside Docker, compose builds it from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://dashnode_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5434/dashnode

# Managed PostgreSQL (e.g. Supabase): use sslmode=require and never commit real passwords.
# DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Admin connection used ONLY by integration tests to create/drop throwaway databases
# (pytest -m integration). Point it at the `postgres` maintenance database.
TEST_POSTGRES_URL=postgresql+psycopg://dashnode_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5434/postgres

# --- Server session (HU_DN_01_03, HU_DN_01_05) ------------------------------
SESSION_COOKIE_NAME=dashnode_session
# Session lifetime in hours counted from login (RNF-SEG-09 / HU_DN_01_05).
SESSION_TTL_HOURS=8
# Extra hours the browser keeps the (already expired) cookie so the API can answer
# "Su sesion ha expirado" instead of a bare 401.
SESSION_COOKIE_RETENTION_HOURS=24
# Must be true when served over HTTPS (mandatory in production).
SESSION_COOKIE_SECURE=false
# lax | strict
SESSION_COOKIE_SAMESITE=lax
# Failed logins allowed per account inside the window (RNF-SEG-06): the next one is rejected.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- Password hashing (Argon2id). Production minimum: time>=2, memory>=19456 KiB
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# --- CORS / CSRF: comma-separated explicit origins (no wildcard) ------------
# 5173 = Vite dev server, 8080 = frontend container.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Server ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Host port published by the api container.
API_HOST_PORT=8000

# --- Mail / password recovery (prepared for HU_DN_01_06; not used in this epic) ---
# Link used inside recovery e-mails; points at the frontend.
FRONTEND_BASE_URL=http://localhost:8080
PASSWORD_RESET_TTL_MINUTES=30
# Example values: replace with your SMTP provider. Leave SMTP_HOST empty to disable mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# --- Local seed users (python -m app.cli.seed). Blocked when APP_ENV=production ---
# generate_env.py fills the passwords with random values. Roles: admin, manager, developer,
# and a deactivated account (used to test HU_DN_01_03 criterion 6).
SEED_ADMIN_EMAIL=admin@dashnode.local
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD
SEED_MANAGER_EMAIL=manager@dashnode.local
SEED_MANAGER_PASSWORD=CHANGE_ME_SEED_MANAGER_PASSWORD
SEED_DEVELOPER_EMAIL=developer@dashnode.local
SEED_DEVELOPER_PASSWORD=CHANGE_ME_SEED_DEVELOPER_PASSWORD
SEED_DISABLED_EMAIL=disabled@dashnode.local
SEED_DISABLED_PASSWORD=CHANGE_ME_SEED_DISABLED_PASSWORD

# Environment Profile (development, production, testing)
APP_ENV=development

# Database Configuration
DATABASE_URL=postgresql+psycopg://dashnode:dashnode@localhost:5432/dashnode

# Security (JWT)
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
JWT_SECRET=super_secret_development_key_only_change_in_prod
JWT_ISSUER=dashnode
JWT_AUDIENCE=dashnode_app
SESSION_TTL_HOURS=8

# CORS
# Comma-separated list of allowed origins. Example: http://localhost:3000,https://app.dashnode.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server
API_HOST=0.0.0.0
API_PORT=8000

#!/usr/bin/env bash
# Git pre-commit hook enforcing Trunk Quality Gates
set -e

echo "🔍 [Trunk-Gate] Validating commit against DashNode Quality Gates..."

echo "1/5 Checking linting (Ruff)..."
ruff check .

echo "2/5 Checking code formatting (Ruff format)..."
ruff format --check .

echo "3/5 Checking strict static types (Mypy)..."
mypy .

echo "4/5 Checking architectural contracts (Import Linter)..."
lint-imports

echo "5/5 Running test suite & coverage (Pytest)..."
pytest tests/unit tests/application tests/api --cov=app --cov-fail-under=80

echo "✅ [Trunk-Gate] All quality gates passed! Proceeding with commit."

#!/usr/bin/env bash
# Git pre-commit hook enforcing the DashNode quality gates.
set -e

echo "[gate] 0/6 Secret scan (staged files)..."
python scripts/scan_secrets.py

echo "[gate] 1/6 Ruff lint..."
ruff check .

echo "[gate] 2/6 Ruff format..."
ruff format --check .

echo "[gate] 3/6 Mypy strict..."
mypy .

echo "[gate] 4/6 Import Linter contracts..."
lint-imports

echo "[gate] 5/6 Tests and coverage..."
pytest tests/unit tests/application tests/api --cov=app --cov-fail-under=80 -q

echo "[gate] All quality gates passed."
